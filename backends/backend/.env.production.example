# MODELE A COMPLETER par l'informaticien ; ne contient aucun secret réel.
# Copier en backend/.env sur le serveur, ou choisir via KILIMA_ENV_FILE.
# Les chemins ci-dessous sont des exemples Linux, à adapter à l'hébergement.
# Ne pas utiliser Demarrer-tests.bat pour la production.
APP_NAME=ERP KILIMA HOLDINGS
ENVIRONMENT=production
DEBUG=false
ALLOWED_HOSTS=erp.votre-domaine.example

# Remplacer utilisateur, mot de passe, serveur et nom de base.
# Encoder les caractères réservés du mot de passe : @ = %40, # = %23.
DATABASE_URL=postgresql://kilima:REMPLACER_MOT_DE_PASSE@db.votre-domaine.example:5432/kilima_erp
DB_TIMEOUT_SECONDS=20
DB_CONN_MAX_AGE=60
DB_SSLMODE=verify-full
# Certificat d'autorité PostgreSQL fourni par l'hébergeur (chemin local).
DB_SSLROOTCERT=/etc/kilima/postgresql-ca.crt

# AUTRES MOTEURS : remplacer la ligne DATABASE_URL active, ne pas en ajouter une seconde.
# Renseigner vos identifiants ; encoder @ en %40, # en %23 et % en %25 dans le mot de passe.
# PostgreSQL (pilote psycopg inclus dans requirements.txt) :
# DATABASE_URL=postgresql://kilima:MOT_DE_PASSE@127.0.0.1:5432/kilima_erp
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/chemin/certificat-autorite-postgresql.crt
# Pour un serveur PostgreSQL local sans TLS uniquement : DB_SSLMODE=disable.
# Les variables DB_SSLMODE et DB_SSLROOTCERT ci-dessus ne concernent pas MySQL.
#
# MySQL : configuration de connexion preparee, exploitation pas encore compatible.
# Les migrations de tracabilite doivent etre adaptees avant toute bascule MySQL.
# Installer le pilote : python -m pip install -r backend/requirements-mysql.txt
# DATABASE_URL=mysql://kilima:MOT_DE_PASSE@127.0.0.1:3306/kilima_erp
# Decommenter les options MySQL ci-dessous selon les informations de l'hebergeur.
# DB_MYSQL_SSL_MODE=VERIFY_IDENTITY
# DB_MYSQL_SSL_CA=/chemin/certificat-autorite-mysql.crt
# DB_MYSQL_SSL_CERT=
# DB_MYSQL_SSL_KEY=
# Pour un serveur MySQL local sans TLS uniquement : DB_MYSQL_SSL_MODE=DISABLED.
# DB_MYSQL_SSL_CERT et DB_MYSQL_SSL_KEY : facultatifs, a fournir ensemble.
# DB_TIMEOUT_SECONDS et DB_CONN_MAX_AGE s'appliquent aux deux moteurs reseau.
# Ces exemples ne migrent aucune donnee et ne modifient pas la base de tests.

# Générer une clé différente pour cet environnement, puis la conserver.
SECRET_KEY=remplacer-par-une-cle-aleatoire-unique-au-moins-50-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

SECURE_SSL_REDIRECT=true
# true seulement si le proxy HTTPS de confiance remplace X-Forwarded-Proto
# et que le serveur Django n'est pas accessible directement de l'extérieur.
TRUST_PROXY_HTTPS=false
# Activer HSTS après validation complète du HTTPS.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Volume persistant privé ; y transférer les pièces jointes existantes.
UPLOADS_DIR=/var/lib/kilima/uploads
MAX_UPLOAD_MB=10

# PostgreSQL : sauvegardes planifiées à organiser avec l'hébergeur.
# Ces réglages de sauvegarde intégrée concernent uniquement SQLite.
BACKUP_ON_STARTUP=false
BACKUP_DIR=
BACKUP_KEEP_COUNT=14
