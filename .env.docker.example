# Copier en .env.docker A LA RACINE du projet, puis renseigner les secrets.
# Ne pas utiliser les .env locaux Windows pour les conteneurs.
# Générer séparément chaque secret : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=kilima
POSTGRES_USER=kilima
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Adresse publique du frontend (le domaine et HTTPS sont configurés chez l'hébergeur).
APP_URL=https://kilimaholdings.com
# Accès local / proxy HTTPS de l'hébergeur sur la même machine.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
