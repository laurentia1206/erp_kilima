    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": { "next": "16.3.5", "react": "19.3.0", "react-dom": "19.3.0", "@tabler/icons-webfont": "2.44.0" },
  "devDependencies": { "typescript": "^5.9.0", "@types/node": "^24.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0" }
