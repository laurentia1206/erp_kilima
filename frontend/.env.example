# Adresse du serveur Django, accessible depuis le serveur Next.js.
# Aucune cle secrete ni connexion a la base de donnees dans le frontend.
DJANGO_API_URL=http://127.0.0.1:8012
# Limite des requetes transmises a Django (Mo), fichiers et formulaire compris.
# Doit depasser MAX_UPLOAD_MB du backend pour laisser la place au formulaire.
API_MAX_BODY_MB=16
