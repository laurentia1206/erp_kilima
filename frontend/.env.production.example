# ==============================================================================
# CONFIGURATION FRONTEND NEXT.JS (DOCKER PRODUCTION)
# Copier sous le nom '.env' ou '.env.production' dans le dossier frontend/
# ==============================================================================

# URL publique principale de votre application ERP
APP_URL=https://kilimaholdings.com

# ------------------------------------------------------------------------------
# COMMUNICATIONS API DJANGO (BACKEND)
# ------------------------------------------------------------------------------
# 1. URL Interne (Next.js SSR / Server-side)
# Dans le réseau privé Docker Compose, le conteneur Next.js appelle Django via le nom de service 'backend' sur le port 8000.
DJANGO_API_URL=http://backend:8000

# 2. URL Publique (Navigateur Web / Client-side)
# Utilisée par le code exécuté dans le navigateur de l'utilisateur.
NEXT_PUBLIC_API_URL=https://kilimaholdings.com

# Taille maximale autorisée pour le corps des requêtes envoyées à l'API (en Mo)
API_MAX_BODY_MB=16