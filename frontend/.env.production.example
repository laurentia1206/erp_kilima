# Copier en .env.production.local pour une installation de production hors Docker.
# Supprimer les réglages de développement de .env.local : ils ont priorité.
APP_URL=https://kilimaholdings.com
# API interne, jamais l'URL publique du frontend (cela créerait une boucle /api).
# Django sur la même machine, hors Docker :
DJANGO_API_URL=http://127.0.0.1:8012
# Sous Docker, Compose fournit automatiquement http://backend:8000.
API_MAX_BODY_MB=16
