# Configuration Django locale. Copier en backend/.env.
# Les variables du système ont priorité. Commentaires sur des lignes séparées.
# Pas de substitution ${VARIABLE}. Chemins relatifs ancrés dans backend/.

# Application et accès local
APP_NAME=ERP KILIMA HOLDINGS
ENVIRONMENT=dev
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Base de recette existante. Ne pas remplacer la base historique.
# Le lanceur Demarrer-tests.bat sélectionne automatiquement la copie de tests.
DATABASE_URL=sqlite:///../.build/qa/kilima_qa.db
# KILIMA_DB remplace DATABASE_URL ; laisser absent en usage normal.
DB_TIMEOUT_SECONDS=20
# Connexions persistantes PostgreSQL/MySQL ; SSL ci-dessous pour PostgreSQL uniquement.
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer
DB_SSLROOTCERT=

# AUTRES MOTEURS : remplacer la ligne DATABASE_URL active, ne pas en ajouter une seconde.
# Renseigner vos identifiants ; encoder @ en %40, # en %23 et % en %25 dans le mot de passe.
# PostgreSQL (pilote psycopg inclus dans requirements.txt) :
# DATABASE_URL=postgresql://kilima:MOT_DE_PASSE@127.0.0.1:5432/kilima_erp
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/chemin/certificat-autorite-postgresql.crt
# Pour un serveur PostgreSQL local sans TLS uniquement : DB_SSLMODE=disable.
# Les variables DB_SSLMODE et DB_SSLROOTCERT ci-dessus ne concernent pas MySQL.
#
# MySQL : configuration de connexion preparee, exploitation pas encore compatible.
# Les migrations de tracabilite doivent etre adaptees avant toute bascule MySQL.
# Installer le pilote : python -m pip install -r backend/requirements-mysql.txt
# DATABASE_URL=mysql://kilima:MOT_DE_PASSE@127.0.0.1:3306/kilima_erp
# Decommenter les options MySQL ci-dessous selon les informations de l'hebergeur.
# DB_MYSQL_SSL_MODE=VERIFY_IDENTITY
# DB_MYSQL_SSL_CA=/chemin/certificat-autorite-mysql.crt
# DB_MYSQL_SSL_CERT=
# DB_MYSQL_SSL_KEY=
# Pour un serveur MySQL local sans TLS uniquement : DB_MYSQL_SSL_MODE=DISABLED.
# DB_MYSQL_SSL_CERT et DB_MYSQL_SSL_KEY : facultatifs, a fournir ensemble.
# DB_TIMEOUT_SECONDS et DB_CONN_MAX_AGE s'appliquent aux deux moteurs reseau.
# Ces exemples ne migrent aucune donnee et ne modifient pas la base de tests.

# Ne jamais partager une vraie clé. Le lanceur en génère une si .env manque.
# Génération manuelle : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# HTTP local ; HTTPS sera configuré sur le serveur de production.
SECURE_SSL_REDIRECT=false
TRUST_PROXY_HTTPS=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Pièces jointes : conserver ce dossier pour retrouver les documents existants.
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10

# Sauvegarde SQLite quotidienne, au premier démarrage du jour uniquement.
# Vide = dossier backups à côté de la base active. Aucun effet sur PostgreSQL/MySQL.
BACKUP_ON_STARTUP=false
BACKUP_DIR=
BACKUP_KEEP_COUNT=14
