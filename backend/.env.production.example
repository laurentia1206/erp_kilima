# ==============================================================================
# CONFIGURATION DE PRODUCTION (DOCKER) - ERP KILIMA HOLDINGS
# Copier ce fichier sous le nom '.env' dans le dossier backend/ sur votre VPS.
# ==============================================================================

APP_NAME=ERP KILIMA HOLDINGS
ENVIRONMENT=production
DEBUG=false

# Domaines autorisés (Séparés par des virgules si plusieurs)
# Exemple : erp.votre-domaine.com,vps12345.cloudsigma.net
ALLOWED_HOSTS=kilimaholdings.com

# ------------------------------------------------------------------------------
# CONFIGURATION POSTGRESQL (DOCKER COMPOSE)
# ------------------------------------------------------------------------------
POSTGRES_DB=kilima_erp
POSTGRES_USER=kilima_user
POSTGRES_PASSWORD=ErpKilimaHoldings2026@#$

# URL de connexion Django
# Le nom d'hôte 'db' correspond au nom du service PostgreSQL dans docker-compose.yml
# Syntaxe : postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://kilima_user:ErpKilimaHoldings2026@#$@db:5432/kilima_erp

DB_TIMEOUT_SECONDS=20
DB_CONN_MAX_AGE=60

# En réseau interne Docker sécurisé, le SSL inter-conteneur n'est pas nécessaire
DB_SSLMODE=disable
DB_SSLROOTCERT=

# ------------------------------------------------------------------------------
# SÉCURITÉ DJANGO
# ------------------------------------------------------------------------------
# Générer une clé unique (ex: openssl rand -hex 32 ou python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=remplacer-par-une-cle-aleatoire-unique-au-moins-50-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SSL / En-têtes Proxy Reverse (Nginx/Traefik sur le VPS)
# Passer TRUST_PROXY_HTTPS à true lorsque Nginx gère le SSL (HTTPS) en amont
SECURE_SSL_REDIRECT=true
TRUST_PROXY_HTTPS=true

# HSTS (Activer après avoir validé que le certificat SSL Nginx fonctionne)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# ------------------------------------------------------------------------------
# VOLUMES & STOCKAGE PERSISTANT (DOCKER)
# ------------------------------------------------------------------------------
# Chemin interne au conteneur Django pour les fichiers téléversés
UPLOADS_DIR=/app/media
MAX_UPLOAD_MB=10

# Les sauvegardes automatiques SQLite sont désactivées pour PostgreSQL
BACKUP_ON_STARTUP=false
BACKUP_DIR=
BACKUP_KEEP_COUNT=14